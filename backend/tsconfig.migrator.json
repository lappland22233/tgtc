{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist-migrator",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/build-data-migrator.ts",
    "src/database/database.config.ts",
    "src/migrations/*-Sqlite*.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
