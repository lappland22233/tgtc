{
  "name": "file-distribution-system-backend",
  "version": "2.1.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.3 <13"
  },
  "description": "Small file distribution system with Telegram storage",
  "main": "dist/main.js",
  "_cryptoNote": "G9-16(P2): bcryptjs 为纯 JS 实现，其异步 API 内部用 setImmediate 让出事件循环，但哈希/比对仍占用主线程 CPU，登录/注册高峰可能阻塞。替代候选：原生 bcrypt（需 node-gyp 编译，安装风险大，未经确认不擅自切换）或 worker_threads 池。TODO: 评估 worker_threads 迁移方案后落地。",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/migrations/Migration",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts src/migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:run:postgres": "cross-env DB_TYPE=postgres typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert:postgres": "cross-env DB_TYPE=postgres typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:run:sqlite": "cross-env DB_TYPE=sqlite DB_MIGRATIONS_RUN=false typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert:sqlite": "cross-env DB_TYPE=sqlite DB_MIGRATIONS_RUN=false typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "test:integration:sqlite": "cross-env DB_TYPE=sqlite npm test -- --runInBand src/database/sqlite-real-qa.spec.ts",
    "test:integration:pg": "cross-env PG_API_KEY_IT=1 npm test -- --runInBand src/database/postgres-api-key.integration.spec.ts src/database/security-review.integration.spec.ts src/storage/gdrive-oauth-store.service.spec.ts",
    "test:migrations:sqlite": "cross-env DB_TYPE=sqlite npm test -- --runInBand src/migrations/sqlite-migrations.spec.ts",
    "gate:sqlite": "npm test -- --runInBand scripts/data-migrator-utils.spec.ts && npm run test:migrations:sqlite && npm run test:integration:sqlite",
    "build:data-migrator": "node -e \"require('node:fs').rmSync('dist-migrator',{recursive:true,force:true})\" && tsc -p tsconfig.migrator.json && node -e \"require('fs').writeFileSync('dist-migrator/build-data-migrator.js','\\\"use strict\\\";\\nrequire(\\\"./scripts/build-data-migrator.js\\\");\\n')\"",
    "check:ci": "npm ls --all && npm audit --omit=dev --audit-level=high && npm run typecheck && npm run build && npm run gate:sqlite && npm run test:integration:redis && npm run test:cov -- --runInBand",
    "test:integration:redis": "cross-env REDIS_IT=1 npm test -- --runInBand src/jobs/bull-real.integration.spec.ts src/jobs/upload-recovery.redis.integration.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/lib-storage": "3.1175.0",
    "@nestjs/bull": "12.0.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/event-emitter": "12.0.3",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/platform-socket.io": "12.6.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/serve-static": "12.1.1",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/websockets": "12.6.0",
    "axios": "1.21.1",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.11.1",
    "bull": "4.16.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "file-type": "22.3.0",
    "form-data": "4.0.6",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "teleproto": "1.233.0",
    "typeorm": "1.1.3",
    "ua-parser-js": "2.0.10",
    "webdav": "5.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "_overridesNote": "Pinned security patches for HTTP/upload parsers, redirects and transitive IP/UUID handling. Bull UUID compatibility is exercised against real Redis; multipart limits and interrupted uploads use real HTTP tests.",
  "overrides": {
    "multer": "2.5.0",
    "follow-redirects": "1.16.3",
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "ip-address": "10.7.6",
    "bull": {
      "uuid": "11.1.1"
    },
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "fast-uri": "3.1.9"
  },
  "packageManager": "npm@12.2.3",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@parcel/watcher@2.6.0": false,
    "msgpackr-extract@3.0.7": false
  }
}
