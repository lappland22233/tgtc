# ==========================================
# 数据库配置（默认 PostgreSQL；SQLite 必须显式 opt-in）
# ==========================================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=file_distribution
# SQLite 单机部署示例：注释上方 PostgreSQL 连接项后显式设置以下值。
# 相对路径基于后端进程工作目录解析；生产环境应固定 WorkingDirectory，禁止随发布漂移。
# DB_TYPE=sqlite
# DB_DATABASE=./data/tgtc.sqlite
# SQLite 等待写锁上限（毫秒）。超时仍会返回 SQLITE_BUSY；不要靠无限等待掩盖并发瓶颈。
# DB_SQLITE_BUSY_TIMEOUT_MS=5000
# DB_SYNCHRONIZE 为兼容项；实现始终关闭 synchronize，所有环境必须使用迁移。
DB_SYNCHRONIZE=false
# 建议部署前显式运行迁移并保持 false；若设为 true，应用启动时会执行待处理迁移。
DB_MIGRATIONS_RUN=false
# 以下连接池/查询超时仅用于 PostgreSQL；SQLite 是单文件数据库，不使用连接池。
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
# DB_SSL=false

# ==========================================
# JWT 认证配置
# ==========================================
# 生产环境务必使用随机生成的强密钥（至少 32 字节随机）。
# 生成方式: openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：留空将导致启动校验失败；使用示例占位值也会被校验拦截，禁止直接复制上线。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# Redis 配置（Bull 消息队列）
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD — Redis 密码，无密码可留空
# REDIS_PASSWORD=
# REDIS_DB — Redis 数据库编号，默认 0
# REDIS_DB=0

# ==========================================
# Telegram Bot 配置（文件存储后端）
# ==========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
#
# ----- Bot 账号池（多账号回源，可选增强；默认关闭时行为与单账号完全一致）-----
# 背景：file_id 按账号隔离，同一文件在不同 Bot 下是不同的 file_id；
#       「按负载挑一个账号回源」的前提是每个账号各自持有该文件的副本。
# 详细设计、验证步骤与回退方式见 beta/account-pool-lab/docs/backend-pool-adaptation.md
#
# 总开关（仅显式 true 时启用；启用后需配置账号来源，否则自动回退单账号链路）
# TELEGRAM_ACCOUNT_POOL_ENABLED=true
# 账号来源 A（推荐，信息最全）：JSON 数组，每项 {id,token,chatId,weight,maxInflight,enabled,note}
# TELEGRAM_ACCOUNT_POOL=[{"id":"bot1","token":"123456:AA...","chatId":"-1001234567890","weight":1,"maxInflight":8},{"id":"bot2","token":"654321:BB...","chatId":"-1001234567890","weight":1,"maxInflight":8}]
# 账号来源 B（简化，兼容输入）：逗号分隔的 token 列表；各账号的存储 Chat 复用 TELEGRAM_CHAT_ID
#（归档群 TELEGRAM_ARCHIVE_CHAT_ID 只用于审计转发，**不得**作为存储目标）
# TELEGRAM_BOT_TOKENS=123456:AA...,654321:BB...
# 归档群：收到的文件用一个账号转发到该群（**仅审计留痕**；注意 bot 看不到其它 bot 的消息，
# 跨账号共享靠副本扩散/用户账号中继，转发不会让其它 bot 获得该文件）
# 同时作为「用户账号中继」在**下载期懒扩散**路径上的副本可见群（需全群 Bot 为管理员或关闭隐私模式）；
# 来自该群的消息只登记副本、不再归档转发，避免按 Bot 数放大消息量。
# TELEGRAM_ARCHIVE_CHAT_ID=-1001234567890
# 回源时期望的副本数（不足则按需扩散；默认 2，设为 1 表示不主动扩散）
# TELEGRAM_POOL_TARGET_REPLICAS=2
# 前置条件（任一不满足时启动预检直接拒绝启用）：
#   TELEGRAM_FILE_STREAMING_ENABLED=true，且 TELEGRAM_FILE_STREAM_BASE 指向自建 Bot API 的流式基址
#   （留空会回落到官方 API，而官方无 /stream/file 端点，池化回源会持续失败）
#   Bot API 需以 --enable-file-streaming 启动；每个账号需有自己的 Token 与存储 Chat
#
# ----- 账号池后台管理 + 文件镜像备份（默认全部关闭；不需要时整块留空即可）-----
# 注意：上面的 TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID（主 Bot）会**始终**注册进账号池注册表，
#   并在后台「Telegram 账号池 → Bot」页签的「环境变量账号」只读区可见（可重新探测，不可编辑/删除）。
#   账号池关闭时它不参与调度，行为与单 Bot 部署完全一致；开启后主 Bot 与其它账号一起按
#   权重 × 带宽 × 健康 × 容量参与下载回源、上传与镜像目标选号。
#   未配置 TELEGRAM_CHAT_ID 时该账号只能参与下载回源，不会被选为上传/镜像目标。
# 账号凭据加密根密钥（32 字节 base64 或 64 位 hex）。**必填才允许在后台新增/轮换账号**：
# 缺失时账号创建与轮换会被拒绝（不会以明文落库）；与 Bot 直链的 TELEGRAM_BOT_ENCRYPTION_KEY 相互独立。
# TELEGRAM_ACCOUNT_ENCRYPTION_KEY=
# 账号池总开关的首次默认值（后台「运行时配置」优先；改后台即时生效，无需重启）
# TELEGRAM_ACCOUNT_POOL_ENABLED=true
# 镜像功能总开关的首次默认值（后台可热切换；关闭只阻止新任务，不中断已开始的传输）
# TELEGRAM_MIRROR_ENABLED=true
# 紧急止血（运维层强制关闭，后台无法覆盖；恢复需移除变量并重启）
# TELEGRAM_ACCOUNT_POOL_FORCE_DISABLED=false
# TELEGRAM_MIRROR_FORCE_DISABLED=false
# 用户账号 MTProto 调用整体超时（毫秒，默认 60000）
# TELEGRAM_USER_CLIENT_TIMEOUT_MS=60000
# 备份群与账号管理入口：后台「Telegram 账号池」页（仅超级管理员）
#   路由：/admin/telegram-accounts   接口：/api/admin/telegram-accounts、/api/admin/telegram-mirror
#
# ----- 用户账号中继（策略 B，可选；已接入 MTProto 客户端）-----
# 作用：让**用户账号**把源消息服务端转发到「副本可见群」，群内每个 Bot 各自收到该消息、
#   登记**自己账号的** file_id 副本 → 副本扩散到全部 Bot → 下载按负载选号。
#   代价是**零字节重传**（只转发消息，不搬文件字节），远低于策略 A 的逐账号二次上传。
# 为什么必须用用户账号：Telegram 规定 bot 永远看不到其它 bot 发送的消息（与隐私模式无关），
#   因此「某个 bot 转发到群」不能让其它 bot 获得该文件；只有用户账号发出的消息才能被全群 bot 看到。
# 前置条件（缺任一项会明确失败并**自动回退策略 A**，不影响文件可用性；启动预检只告警不阻断）：
#   1) 在后台「Telegram 账号池 → 用户」授权至少一个 user 账号并启用（session 加密存库，
#      不再依赖 TELEGRAM_USER_SESSION_FILE）；
#   2) 该账号同时是源群与副本可见群的成员，且对副本可见群有发送权限；
#   3) 副本可见群内**每个 Bot 都需关闭隐私模式或设为管理员**（否则收不到用户账号的普通群消息）；
#   4) 至少启用账号池并配置 ≥2 个 Bot，否则没有负载均衡对象。
# 中继目标群解析顺序：**启用中的镜像规则备份群**优先，其次回退 TELEGRAM_ARCHIVE_CHAT_ID。
# TELEGRAM_USER_RELAY_ENABLED=false
# TELEGRAM_API_BASE — Telegram API 基础地址，留空默认为 https://api.telegram.org
# 自建 API 代理（如 telegram-bot-api）可设为此地址以绕过官方频率限制
# TELEGRAM_API_BASE=http://localhost:8081
# 二次开发 Bot API 的 file_id 实时流端点（冷文件边传输边构建缓存）
# Bot API 需使用 --enable-file-streaming 启动，端点为 /stream/file/bot<TOKEN>/<file_id>
# TELEGRAM_FILE_STREAMING_ENABLED=true
# TELEGRAM_FILE_STREAM_BASE=http://localhost:8081
# TELEGRAM_FILE_STREAM_TIMEOUT_SECONDS=180
#
# ===== 以下为真实生效的环境变量（.env 生效，非 SystemConfig）=====
# 缓存构建 watchdog：三层超时（首字节 / 空闲 / 总时限，单位毫秒，0 表示禁用）
# 重要：总时限默认 0（禁用）。固定总时限不随进度刷新，会把低于约 2.28MiB/s 的
# 4GiB 长传输直接误杀——真正的卡死由首字节超时与「有进度即刷新」的空闲超时判定。
# 层级关系必须为：总时限(如启用) > 首字节 >= 空闲，且首字节 > TELEGRAM_FILE_STREAM_TIMEOUT_SECONDS*1000。
# FILE_CACHE_BUILD_FIRST_BYTE_TIMEOUT_MS=210000
# FILE_CACHE_BUILD_IDLE_TIMEOUT_MS=150000
# FILE_CACHE_BUILD_TOTAL_TIMEOUT_MS=0
# Node HTTP 空闲超时（秒）。必须大于缓存空闲超时，否则 Node 先断 socket，
# 长传输会表现为「无原因中断」而非可分类的超时；也应小于外层 Nginx 的 read timeout。
# HTTP_IDLE_TIMEOUT_SECONDS=180
# FILE_CACHE_NO_CACHE_MODE=false  # 无缓存模式：不发布正式缓存，下载仍写临时中转文件；初始值取自该环境变量，之后由后台热更新
#
# ===== 以下为 SystemConfig 键（管理后台热更新；环境变量不是它们的来源）=====
# 下载资源调度 与 缓存容量/TTL 的唯一来源是管理后台「下载资源调度 / 缓存配置」
# 以 SystemConfig 的持久化值；下列环境变量**不会被读取**，此处仅列出默认值供参考，
# 修改配置请在管理后台操作。涉及键：
#   FILE_CACHE_MAX_SIZE_GB / FILE_CACHE_MIN_FREE_DISK_GB / FILE_CACHE_TTL_DAYS
#   FILE_DOWNLOAD_MAX_RESERVED_GB / FILE_DOWNLOAD_MAX_CONCURRENT_UPSTREAMS /
#   FILE_DOWNLOAD_QUEUE_CAPACITY / FILE_DOWNLOAD_QUEUE_TIMEOUT_SECONDS /
#   FILE_DOWNLOAD_SPOOL_GRACE_SECONDS / FILE_DOWNLOAD_DIRECT_WINDOW_MB /
#   FILE_DOWNLOAD_DIRECT_WAIT_SECONDS / FILE_DOWNLOAD_TASK_RETENTION_SECONDS
# 已获得预约的下载任务不会被新任务抢占；完整暂存不可行时自动降级为受限缓冲直通。
# FILE_DOWNLOAD_MAX_RESERVED_GB=0            # 在途任务未写入预约总上限（GB），0=仅受物理空间约束
# FILE_DOWNLOAD_MAX_CONCURRENT_UPSTREAMS=8   # 上游冷回源“权重预算”（非连接数）：>1GiB 权重 8 / 256MiB–1GiB 权重 2 / 其余 1
# FILE_DOWNLOAD_QUEUE_CAPACITY=128           # 磁盘/上游等待队列容量
# FILE_DOWNLOAD_QUEUE_TIMEOUT_SECONDS=1800   # 单个任务排队等待上限（秒）
# FILE_DOWNLOAD_SPOOL_GRACE_SECONDS=120      # 临时中转文件最后一个下载者离开后的保留时间（秒）
# FILE_DOWNLOAD_DIRECT_WINDOW_MB=16          # 直通模式缓冲窗口（MB），越小内存占用越低
# FILE_DOWNLOAD_DIRECT_WAIT_SECONDS=60       # 直接下载端点的有限等待上限（秒）
# FILE_DOWNLOAD_TASK_RETENTION_SECONDS=900   # 下载任务状态保留时间（秒）
# TELEGRAM_LOCAL_FILE_DIR — 自建 telegram-bot-api 本地文件存储目录（可选）
# 设置后可直接从文件系统读取文件，跳过 Telegram API 下载，显著提升速度
# 需要与 telegram-bot-api 的 --dir 参数保持一致
# 注意：此目录内容必须永久保留，不可清空或重命名，否则历史 file_id 将全部失效
# TELEGRAM_LOCAL_FILE_DIR=/var/lib/telegram-bot-api
# FILE_PROCESSING_STALE_MINUTES — 上传队列僵尸任务自动恢复阈值（分钟，默认 60）
# status=processing 且超过该时长未更新的 pending/uploading 记录会被定时任务标记为 error
# FILE_PROCESSING_STALE_MINUTES=60

# ==========================================
# Telegram Bot 入站（文件直链，默认关闭）
# ==========================================
# 用户在 Bot 私聊中发送「文件」可获得带有效期的匿名下载直链。
# 重要：同一 Bot Token 只能有一个入站消费者；启用前必须确认没有设置 Webhook。
# 入站消费总开关，仅显式 true 时启用（不支持热更新）
# TELEGRAM_BOT_UPDATES_ENABLED=false
# 初始管理员 TG 用户 ID（逗号分隔）；开启入站时必填，否则无人可维护白名单
# TELEGRAM_BOT_ADMIN_IDS=
# 长轮询超时（秒，1–120，默认 30）
# TELEGRAM_BOT_POLL_TIMEOUT_SECONDS=30
# 入站启动自检延迟（秒，1–300，默认 20；显式 0 关闭自检）
# 自检若发现「已启用入站但启动后没有任何一次成功的 getUpdates」，会输出 error 级日志
# 与只读诊断接口结论，用于发现「循环空转」这类无日志无异常的静默失效
# TELEGRAM_BOT_INBOUND_SELF_CHECK_SECONDS=20
# 直链 Token 可逆加密根密钥（32 字节 base64 或 64 位 hex）
# 生成方式: openssl rand -base64 32 或 openssl rand -hex 32
# 缺失时仍可签发直链，但管理员 /link_query 只能返回前缀（无法回放完整链接）
# TELEGRAM_BOT_ENCRYPTION_KEY=
# 以下四项在管理后台「Telegram Bot 设置」中可热更新，此处仅为 env 兜底默认值
# 非白名单用户每日直链额度（默认 5）
# TELEGRAM_BOT_DAILY_LIMIT=5
# 直链有效期（小时，1–720，默认 4）
# TELEGRAM_BOT_LINK_TTL_HOURS=4
# 每日额度切日时区（IANA，默认 Asia/Shanghai）
# TELEGRAM_BOT_QUOTA_TIMEZONE=Asia/Shanghai
# 站点域名模式：auto（自动获取，优先 APP_URL）或 manual（手动设置）
# TELEGRAM_BOT_LINK_DOMAIN_MODE=auto
# 手动模式下的站点域名，如 https://example.top（不含路径）
# TELEGRAM_BOT_LINK_DOMAIN=

# ==========================================
# SMTP 邮件配置
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com
# SMTP_ENCRYPTION_KEY — SMTP 密码加密密钥（配置 SMTP_HOST 时必填，启动校验强制要求）
# 必须为随机 hex 字符串，禁止使用示例占位值（会被启动校验拦截）。
# 生成方式: openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_ENCRYPTION_KEY=
# SMTP_ENCRYPTION_SALT — SMTP 密码加密盐值（配置 SMTP_HOST 时必填，启动校验强制要求）
# 必须为随机 hex 字符串，禁止使用示例占位值（会被启动校验拦截）。
# 生成方式: openssl rand -hex 16 或 node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SMTP_ENCRYPTION_SALT=

# ==========================================
# 应用配置
# ==========================================
NODE_ENV=development
# APP_HOST — 后端监听地址。默认 127.0.0.1（仅本机可访问），公网访问必须经反向代理
# （Caddy/nginx）转发，不要让 Node 直接监听 0.0.0.0 暴露到公网。
# 容器/多网卡场景确需监听所有网卡时显式设为 0.0.0.0，并同时配置 TRUST_PROXY_HOPS。
APP_HOST=127.0.0.1
APP_PORT=3000
# TRUST_PROXY_HOPS — 可信反向代理层数。位于反向代理之后时必须设置（如 1）；
# 直连公网或本机开发保持不设置（0 表示不信任任何代理，X-Forwarded-For 一律不采信）。
# TRUST_PROXY_HOPS=1
# DEPLOYMENT_MODE — 部署形态：single（默认，唯一支持值）或 multi。
# 当前版本核心链路存在进程内内存态，多实例部署会随机失败，设为 multi 将被启动预检直接拒绝。
# DEPLOYMENT_MODE=single
# APP_URL — 应用完整公开地址，用于生成分享链接和密码页表单 action
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS — 逗号分隔的 CORS 允许来源（优先级高于 FRONTEND_URL）
CORS_ORIGINS=http://localhost:5173
# SECURE_COOKIE — 生产环境（HTTPS）设为 true 强制 Cookie secure 标志
# SECURE_COOKIE=true
# TOKEN_EXTRACTION_MODE — Token 提取方式：both（Cookie + Bearer，默认）或 cookie_only（仅 Cookie）
# TOKEN_EXTRACTION_MODE=both

# ==========================================
# 文件上传配置
# ==========================================
# 最大文件大小（字节），默认 83886080 = 80MB（Cloudflare 代理层安全余量）
MAX_FILE_SIZE=83886080
# 文件类型过滤模式：blacklist（黑名单）或 whitelist（白名单），默认 blacklist
# FILE_TYPE_MODE=blacklist
# 文件类型过滤列表，逗号分隔的扩展名，如 .zip,.exe,.sh。空值 = 不限制
# FILE_TYPE_FILTER=
# 分片上传资源保护：单用户/全局同时接收数、全局在途字节预算、临时分区最小预留空间
# CHUNK_UPLOAD_USER_CONCURRENCY=3
# CHUNK_UPLOAD_GLOBAL_CONCURRENCY=24
# CHUNK_UPLOAD_INFLIGHT_BYTES=268435456
# CHUNK_UPLOAD_MIN_FREE_DISK_BYTES=1073741824
# 严格小盘模式：仅在单个后端进程 + FILE_CACHE_NO_CACHE_MODE=true 时设为 true。
# 所有上传统一走分片链路，服务端以最大文件两倍空间为预算串行接收；启用前须先排空既有 processing/pending 任务。
# STRICT_UPLOAD_SINGLE_PROCESS=false

# ==========================================
# 日志保留策略
# ==========================================
# 访问日志保留天数（默认 30 天）
ACCESS_LOG_RETENTION_DAYS=30
# 审计日志保留天数（默认 90 天）
AUDIT_LOG_RETENTION_DAYS=90

# ==========================================
# 应用日志分片与轮转（FileLogger）
# ==========================================
# 日志目录，默认 <cwd>/tmp/logs（相对路径基于进程工作目录解析）
# LOG_DIR=tmp/logs
# 分片粒度：daily（按天，默认）或 hourly（按小时），便于快速定位某时段日志
# LOG_ROTATION_INTERVAL=daily
# 单个日志文件最大字节数，超过后归档为 app-YYYY-MM-DD.log.1 / .2 ...（默认 20971520 = 20MB）
# LOG_MAX_FILE_SIZE=20971520
# 日志文件保留天数，超期文件按修改时间自动清理（默认 7 天）
# LOG_RETENTION_DAYS=7
