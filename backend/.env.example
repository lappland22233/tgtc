# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=file_distribution
# DB_SYNCHRONIZE — 禁止自动同步，统一通过迁移管理表结构，避免实体差异误改数据库
DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN — 启动时自动执行待处理迁移（生产环境推荐使用）
DB_MIGRATIONS_RUN=false

# ==========================================
# JWT 认证配置
# ==========================================
# 生产环境务必使用随机生成的强密钥
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ==========================================
# Redis 配置（Bull 消息队列）
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD — Redis 密码，无密码可留空
# REDIS_PASSWORD=
# REDIS_DB — Redis 数据库编号，默认 0
# REDIS_DB=0

# ==========================================
# Telegram Bot 配置（文件存储后端）
# ==========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# TELEGRAM_API_BASE — Telegram API 基础地址，留空默认为 https://api.telegram.org
# 自建 telegram-bot-api 可设为此地址，以绕过官方频率和文件大小限制
# TELEGRAM_API_BASE=http://localhost:8081
# 文件下载必须在此时间内返回首字节，否则判定启动失败；应小于 CDN/LB 超时
TELEGRAM_FIRST_BYTE_TIMEOUT_MS=15000
# 流建立后的 Axios 空闲超时，默认 5 分钟
TELEGRAM_DOWNLOAD_TIMEOUT_MS=300000
# TELEGRAM_LOCAL_FILE_DIR — 自建 telegram-bot-api 的 --dir 工作目录
# 自建 API 的 getFile 返回绝对路径时，系统会在此白名单目录中直接读取，不会拼接 /file URL
# 必须永久保留该目录内容；旧路径缺失时会通过同一 TELEGRAM_API_BASE 的 getFile 刷新一次
# getFile 仍无法解析 file_id 或刷新后的文件仍缺失时，只能重新上传原文件
# TELEGRAM_LOCAL_FILE_DIR=/var/lib/telegram-bot-api

# ==========================================
# SMTP 邮件配置
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com

# ==========================================
# 应用配置
# ==========================================
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
# APP_URL — 应用完整公开地址，用于生成分享链接和密码页表单 action
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS — 逗号分隔的 CORS 允许来源（优先级高于 FRONTEND_URL）
CORS_ORIGINS=http://localhost:5173
# SECURE_COOKIE — 生产环境（HTTPS）设为 true 强制 Cookie secure 标志
# SECURE_COOKIE=true
# TOKEN_EXTRACTION_MODE — Token 提取方式：both（Cookie + Bearer，默认）或 cookie_only（仅 Cookie）
# TOKEN_EXTRACTION_MODE=both

# ==========================================
# 文件上传配置
# ==========================================
# 最大文件大小（字节），默认 83886080 = 80MB（Cloudflare 代理层安全余量）
MAX_FILE_SIZE=83886080
# 文件类型过滤模式：blacklist（黑名单）或 whitelist（白名单），默认 blacklist
# FILE_TYPE_MODE=blacklist
# 文件类型过滤列表，逗号分隔的扩展名，如 .zip,.exe,.sh。空值 = 不限制
# FILE_TYPE_FILTER=

# ==========================================
# 日志保留策略
# ==========================================
# 访问日志保留天数（默认 30 天）
ACCESS_LOG_RETENTION_DAYS=30
# 审计日志保留天数（默认 90 天）
AUDIT_LOG_RETENTION_DAYS=90
