{
  "name": "file-distribution-system-frontend",
  "version": "2.0.1",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.3 <13"
  },
  "packageManager": "npm@12.2.3",
  "allowScripts": {
    "fsevents@2.3.3": false
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "npm run typecheck",
    "check:style": "node scripts/check-style-hygiene.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:bundle:update": "node scripts/check-bundle-size.mjs --write",
    "check:ci": "npm ls --all && npm audit --omit=dev --audit-level=high && npm run build && npm run check:bundle && npm run test:cov"
  },
  "dependencies": {
    "axios": "1.21.1",
    "echarts": "6.1.0",
    "pinia": "4.1.0",
    "tdesign-icons-vue-next": "0.4.12",
    "tdesign-vue-next": "1.20.11",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "follow-redirects": "1.16.3",
    "source-map-js": "1.2.4",
    "js-beautify": {
      "glob": "14.0.6",
      "editorconfig": {
        "minimatch": "11.0.9"
      }
    }
  }
}
