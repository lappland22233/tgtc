{
  "name": "file-distribution-system-frontend",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:bundle:update": "node scripts/check-bundle-size.mjs --write"
  },
  "dependencies": {
    "axios": "1.20.0",
    "echarts": "^6.1.0",
    "pinia": "^2.1.7",
    "tdesign-icons-vue-next": "^0.2.0",
    "tdesign-vue-next": "1.20.5",
    "vue": "3.5.41",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "~5.3.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "6.1.0",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  }
}
